<?php

namespace App\Models;

// use Illuminate\Contracts\Auth\MustVerifyEmail;
use Database\Factories\UserFactory;
use Illuminate\Database\Eloquent\Attributes\Fillable;
use Illuminate\Database\Eloquent\Attributes\Hidden;
use Illuminate\Database\Eloquent\Factories\HasFactory;
use Illuminate\Database\Eloquent\Relations\HasMany;
use Illuminate\Database\Eloquent\Relations\HasOne;
use Illuminate\Foundation\Auth\User as Authenticatable;
use Illuminate\Database\Eloquent\Relations\BelongsTo;
use Illuminate\Notifications\Notifiable;
use Laravel\Sanctum\HasApiTokens;
use PixiiBomb\Core\Models\AgentConversation;
use PixiiBomb\Core\Models\AgentConversationMessage;
use PixiiBomb\Core\Models\Role;
use PixiiBomb\Core\Models\UserSetting;

#[Fillable(['role_id', 'username', 'avatar', 'email', 'password'])]
#[Hidden(['password', 'remember_token'])]
class User extends Authenticatable
{
    /** @use HasFactory<UserFactory> */
    use HasApiTokens, HasFactory, Notifiable;

    /**
     * Get the attributes that should be cast.
     *
     * @return array<string, string>
     */
    protected function casts(): array
    {
        return [
            'email_verified_at' => 'datetime',
            'password' => 'hashed',
        ];
    }

    /**
     * Get the role assigned to the user.
     */
    public function role(): BelongsTo
    {
        return $this->belongsTo(Role::class);
    }

    /**
     * Get the user's settings.
     */
    public function settings(): HasOne
    {
        return $this->hasOne(UserSetting::class);
    }

    /**
     * Get the user's avatar asset path.
     */
    public function getAvatarPath(): string
    {
        $avatar = $this->avatar ?: 'default.png';

        return "images/avatars/{$avatar}";
    }

    /**
     * Get the user's AI conversations.
     */
    public function agentConversations(): HasMany
    {
        return $this->hasMany(AgentConversation::class);
    }

    /**
     * Get the user's AI conversation messages.
     */
    public function agentConversationMessages(): HasMany
    {
        return $this->hasMany(AgentConversationMessage::class);
    }
}
